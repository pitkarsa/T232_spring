package com.itvedant.uservalidations.services;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.web.server.ResponseStatusException;

import com.itvedant.uservalidations.models.User;
import com.itvedant.uservalidations.models.UserDto;
import com.itvedant.uservalidations.repositories.UserRepository;

@Service
public class UserService {

	@Autowired
	private UserRepository userRepository;
	
	public User registerUser(UserDto dto) {
		// if password mismatch throw exception
		if (! dto.getPassword().equals(dto.getConfirmPassword())) {
			throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Passwords must be same");
		}
		// check uniqueness of email
//		if not unique throw exception
	
		
		// create User object
		User user = new User();
		user.setUsername(dto.getUsername()); // ideally it should be encrypted
		user.setEmail(dto.getEmail());
		user.setPassword(dto.getPassword());
		//save user object
		User dbUser = userRepository.save(user);
		return dbUser;
	}
}






